# ════════════════════════════════════════════════════════════
# PiyasaIQ Bot - Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun
# ════════════════════════════════════════════════════════════

# ── Upstash Redis (Ücretsiz: https://console.upstash.com) ────
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxx

# ── Vercel Cron Güvenlik Anahtarı ────────────────────────────
# Rastgele güçlü bir şifre seçin (örn: openssl rand -hex 32)
BOT_CRON_SECRET=buraya-cok-guclu-bir-sifre-yazin

# ── Resend E-Posta API'si (Opsiyonel, ücretsiz 3000/ay) ──────
# https://resend.com ücretsiz hesap açın
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Uygulama URL'si (Vercel otomatik doldurur) ───────────────
# VERCEL_URL otomatik set edilir, bu satırı doldurmaya gerek yok
# NEXT_PUBLIC_APP_URL=https://sizin-projeniz.vercel.app
